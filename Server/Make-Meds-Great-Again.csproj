<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>MakeMedsGreatAgain</RootNamespace>
    <Version>1.3.0</Version>
    <Authors>viniHNS</Authors>
    <Company>viniHNS</Company>
    <Product>Make-Meds-Great-Again</Product>
    <Description>Improves the healing experience in SPT: better medical kits, movement while healing and new meds.</Description>
    <Copyright>Copyright © viniHNS</Copyright>
    <RepositoryUrl>https://github.com/viniHNS/Make-Meds-Great-Again</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.6" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.6" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client\Make-Meds-Great-Again.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>


  <ItemGroup>
    <_ContentIncludedByDefault Remove="dist\package.json" />
    <Content Update="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <SptModsDir>D:\Jogos\SPT4.1\SPT_Runtime\user\mods</SptModsDir>
  </PropertyGroup>

  <!-- Deploy to the local SPT install for testing. Overwrites the installed config.json. -->
  <Target Name="DeployToSpt" AfterTargets="Build" Condition="Exists('$(SptModsDir)')">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)config.json" DestinationFolder="$(SptModsDir)\$(AssemblyName)" />
    <Message Text="--- Deployed server mod to $(SptModsDir)\$(AssemblyName) ---" Importance="high" />
  </Target>

  <Target Name="PackageModForDistribution" AfterTargets="Build">
    <PropertyGroup>
      <ModName>$(AssemblyName)</ModName>
      <ZipFileName>$(ModName).zip</ZipFileName>
      <TempPackageDir>$(ProjectDir)obj\Package</TempPackageDir>
      <ModPackageDir>$(TempPackageDir)\SPT_Runtime\user\mods\$(ModName)</ModPackageDir>
    </PropertyGroup>
    <Message Text="--- Starting Mod packaging for distribution ---" Importance="high" />
    <RemoveDir Directories="$(TempPackageDir)" />
    <MakeDir Directories="$(ModPackageDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)config.json" DestinationFolder="$(ModPackageDir)" />

    <MakeDir Directories="$(TempPackageDir)\BepInEx\plugins" />
    <Copy SourceFiles="$(ProjectDir)..\Client\bin\$(Configuration)\netstandard2.1\$(AssemblyName).dll" DestinationFolder="$(TempPackageDir)\BepInEx\plugins" />
    <ZipDirectory SourceDirectory="$(TempPackageDir)" DestinationFile="$(ProjectDir)..\$(ZipFileName)" Overwrite="true" />

    <RemoveDir Directories="$(TempPackageDir)" />
    <Message Text="--- Mod successfully packaged at: $(ProjectDir)$(ZipFileName) ---" Importance="high" />
  </Target>
</Project>
